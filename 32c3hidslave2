// ───────────────────────────────
// 🔧 Helpers
// ───────────────────────────────
float runningAverage(float *buffer, int &index, bool &filled, float newValue) {
  buffer[index] = newValue;
  index = (index + 1) % AVG_COUNT;
  if (index == 0)
    filled = true;
  int count = filled ? AVG_COUNT : index;
  float sum = 0;
  for (int i = 0; i < count; i++)
    sum += buffer[i];
  return sum / count;
}

int mapTo255(int value, int in_min, int in_max) {
  int mapped = map(value, in_min, in_max, 0, 255);
  return constrain(mapped, 0, 255);
}

int mapTo100(int value, int in_min, int in_max) {
  int mapped = map(value, in_min, in_max, 0, 100);
  return constrain(mapped, 0, 100);
}
