#include <Arduino.h>
#include <U8g2lib.h>
#include <Wire.h>
#include <Preferences.h>

#define SDA_PIN 5
#define SCL_PIN 6
U8G2_SSD1306_72X40_ER_F_HW_I2C u8g2(U8G2_R0, /* reset=*/U8X8_PIN_NONE);

// ───────────────────────────────
// ⚙️ CONFIGURATION
// ───────────────────────────────
#define POT1_PIN 4 // THROTTLE
#define POT2_PIN 1 // STEERING
#define BTN1_PIN 3 
#define BTN2_PIN 0 
#define AVG_COUNT 10
#define SEND_INTERVAL 20

// ───────────────────────────────
// 📦 Data Structure & Instances
// ───────────────────────────────
struct ControlData {
  int pot1;
  int btn1;
  int btn2;
} data;

Preferences prefs;

// ───────────────────────────────
// 📈 Averaging Buffers
// ───────────────────────────────
float buffer1[AVG_COUNT];
float buffer2[AVG_COUNT];
int index1 = 0, index2 = 0;
bool filled1 = false, filled2 = false;

// ───────────────────────────────
// 🧠 Calibration storage
// ───────────────────────────────

int pot1Min = 0, pot1Max = 4095;
int pot2Min = 0, pot2Max = 4095;
int v1;
int v2;
unsigned long cstart = 0;

// ───────────────────────────────
// 🕐 Timers & variables
// ───────────────────────────────
unsigned long lastSend = 0;
unsigned long ldisplay = 0;
unsigned long buttonPressStart = 0;
bool boostState = false;
bool stopState = false;
bool started = false;
bool center = true;

// ───────────────────────────────
// 🧩 ICONS
// ───────────────────────────────
const uint8_t boost_icon[8] = {
  0b00011000,
  0b00111100,
  0b01111110,
  0b11111111,
  0b00111100,
  0b00111100,
  0b00111100,
  0b00000000
};
const uint8_t stop_icon[8] = {
  0b00000000,
  0b01111110,
  0b01111110,
  0b01111110,
  0b01111110,
  0b01111110,
  0b00000000,
  0b00000000
};

// ───────────────────────────────
// 🔧 Helpers
// ───────────────────────────────
float runningAverage(float *buffer, int &index, bool &filled, float newValue) {
  buffer[index] = newValue;
  index = (index + 1) % AVG_COUNT;
  if (index == 0)
    filled = true;
  int count = filled ? AVG_COUNT : index;
  float sum = 0;
  for (int i = 0; i < count; i++)
    sum += buffer[i];
  return sum / count;
}

int mapTo255(int value, int in_min, int in_max) {
  int mapped = map(value, in_min, in_max, 0, 255);
  return constrain(mapped, 0, 255);
}

int mapTo100(int value, int in_min, int in_max) {
  int mapped = map(value, in_min, in_max, 0, 100);
  return constrain(mapped, 0, 100);
}

// ───────────────────────────────
// 💾 Calibration
// ───────────────────────────────
void loadCalibration() {
  prefs.begin("calib", true);
  pot1Min = prefs.getInt("p1min", 0);
  pot1Max = prefs.getInt("p1max", 4095);
  prefs.end();
  v1 = analogRead(POT1_PIN);
  int var = abs(v1 - pot1Min);

  Serial.printf("Loaded calibration: P1[%d-%d]\n", pot1Min, pot1Max);
}

void saveCalibration() {
  prefs.begin("calib", false);
  prefs.putInt("p1min", pot1Min);
  prefs.putInt("p1max", pot1Max);
  prefs.end();
  Serial.println("Calibration saved.");
}

// ───────────────────────────────
// 🚀 Setup
// ───────────────────────────────
void setup() {
  Serial.begin(115200);
  Wire.begin(SDA_PIN, SCL_PIN);
  u8g2.begin();
  pinMode(BTN1_PIN, INPUT_PULLUP);
  pinMode(BTN2_PIN, INPUT_PULLUP);
  analogReadResolution(12);
  loadCalibration();
  Serial.println("Sender started");
}

// ───────────────────────────────
// 🔁 Loop
// ───────────────────────────────
void loop() {
  unsigned long now = millis();
  
  if (now - lastSend >= SEND_INTERVAL) {
    lastSend = now;
    
    if (digitalRead(BTN1_PIN) == LOW) {
      boostState = true;
    } else {
      boostState = false;
    }
    
    if (digitalRead(BTN2_PIN) == LOW) {
      stopState = true;
    } else {
      stopState = false;
    }
    
    int raw1 = analogRead(POT1_PIN);
    int raw2 = analogRead(POT2_PIN);
    float avg1 = runningAverage(buffer1, index1, filled1, raw1);
    float avg2 = runningAverage(buffer2, index2, filled2, raw2);
    int pwm = mapTo255((int)avg1, pot1Min, pot1Max);
    
    if ((pwm < 25) || (stopState == true))
      pwm = 0;

    if (!boostState)
      data.pot1 = constrain(pwm, 0, 200);
    else
      data.pot1 = constrain(pwm, 0, 255);

    data.btn1 = boostState;
    data.btn2 = stopState;

    Serial.printf("P1=%d, B1=%d, B2=%d\n", data.pot1, data.btn1, data.btn2);
  }

  if (now - ldisplay >= 200) {
    ldisplay = now;
    doScreen();
  }
}

// ───────────────────────────────
// 🖥️ OLED Display
// POT1 = Throttle (Forward)
// POT2 = Steering (Left/Right)
// ───────────────────────────────
void doScreen(void) {
  u8g2.clearBuffer();

  u8g2.setFont(u8g2_font_6x10_tr);

  // ── BOOST ICON ──
  u8g2.drawXBMP(0, 5, 8, 8, boost_icon);
  u8g2.drawStr(55, 10, "DRS");
  u8g2.drawStr(55, 20, boostState ? "ON" : "OFF");

  int centerX = 36; // screen center (72px wide)
  
  // ─────────────────────
  // ⚙️ POT1 THROTTLE BAR
  // ─────────────────────
  int rawThrottle = analogRead(POT1_PIN);
  int mappedThrottle = map(rawThrottle, pot1Min, pot1Max, 0, 255);
  mappedThrottle = constrain(mappedThrottle, 0, 255);

  int barLength1 = map(abs(mappedThrottle), 0, 255, 0, 36);
  u8g2.drawLine(30, 38, 42, 38);
  u8g2.drawBox(32, 38 - barLength1, 10, barLength1); // throttle bar

  // ─────────────────────
  // 🏎️ POT2 STEERING BAR
  // ─────────────────────
  int rawSteer = analogRead(POT2_PIN);
  int mappedSteer = map(rawSteer, pot2Min, pot2Max, -255, 255);
  mappedSteer = constrain(mappedSteer, -255, 255);

  int barLength2 = map(abs(mappedSteer), 0, 255, 0, 15);
  u8g2.drawVLine(centerX, 5, 7); // center marker

  if (mappedSteer < 0)
    u8g2.drawBox(centerX - barLength2, 6, barLength2, 5); // left
  else if (mappedSteer > 0)
    u8g2.drawBox(centerX + 1, 6, barLength2, 5); // right

  // Debug readout
  u8g2.setFont(u8g2_font_5x7_tr);
  char steerBuf[16];
  sprintf(steerBuf, "S:%3d", mappedSteer);
  u8g2.drawStr(0, 28, steerBuf);

  u8g2.sendBuffer();
}
